includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
    level: 3
    universalObjectCratesClasses:
        - WP_Post
    scanDirectories:
        - inc/
    scanFiles:
        - avpvh-print-website.php
    paths:
        - src/
        - inc/
    bootstrapFiles:
        - phpstan-bootstrap.php
