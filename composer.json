{
    "name": "grmt/avpvh-print-website",
    "description": "AV-PvH Print Website: print, PDF and eBook versions of WordPress content. Based on Print My Blog by Michael Nelson.",
    "license": "GPL-2.0-or-later",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "szepeviktor/phpstan-wordpress": "^0.7.0",
        "squizlabs/php_codesniffer": "^3.5.4",
        "wp-coding-standards/wpcs": "^2.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7.2"
    },
    "config": {
        "optimize-autoloader": true,
        "platform-check": false,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Avpvh\\PrintWebsite\\mnelson4\\": "src/mnelson4/",
            "Avpvh\\PrintWebsite\\Twine\\": "src/Twine/",
            "Avpvh\\PrintWebsite\\": "src/PrintMyBlog/"
        }
    },
    "scripts": {
        "release": "git archive HEAD --format=zip --output ../avpvh-print-website.zip && git tag",
        "phpstan": "phpstan analyze --debug",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf"
    }
}
