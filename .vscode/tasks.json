{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AV-PvH Print Website: Package Plugin",
      "type": "shell",
      "command": "npm run package:plugin",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "AV-PvH Print Website: Deploy Plugin to WordPress",
      "type": "shell",
      "command": "npm run deploy:playwright",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "WP_ADMIN_PASSWORD": "${command:printmyblog.getWpAdminPassword}"
        }
      },
      "dependsOn": "AV-PvH Print Website: Package Plugin",
      "problemMatcher": []
    }
  ]
}
