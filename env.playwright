# Copy this file to .env before running the Playwright deploy script:
# cp env.playwright .env
#
# .env is gitignored and intended for your real local secrets.
# If you use the VS Code SecretStorage task flow, leave WP_ADMIN_PASSWORD empty here.

WP_BASE_URL="https://your-site.example"
WP_ADMIN_USER="admin"
WP_ADMIN_PASSWORD=""
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_LOCALE="en-US"
PLAYWRIGHT_CLOSE_DELAY_MS=5000
