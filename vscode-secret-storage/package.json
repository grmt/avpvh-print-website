{
  "name": "printmyblog-vscode-secret-storage",
  "displayName": "AV-PvH Print Website Secret Storage",
  "description": "Workspace commands for storing the WordPress admin password in VS Code SecretStorage.",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:printmyblog.setWpAdminPassword",
    "onCommand:printmyblog.getWpAdminPassword",
    "onCommand:printmyblog.clearWpAdminPassword",
    "onCommand:printmyblog.deployPlugin"
  ],
  "contributes": {
    "commands": [
      {
        "command": "printmyblog.deployPlugin",
        "title": "AV-PvH Print Website: Deploy Plugin to WordPress"
      },
      {
        "command": "printmyblog.setWpAdminPassword",
        "title": "AV-PvH Print Website: Save WP Admin Password"
      },
      {
        "command": "printmyblog.clearWpAdminPassword",
        "title": "AV-PvH Print Website: Clear WP Admin Password"
      }
    ]
  }
}
